<div class="dcf-shell"><header class="dcf-banner"><img src="{{item.img}}" alt=""><div><small>WORLD DUNGEON // ITEM RECORD</small><input data-field="name" value="{{item.name}}" aria-label="Item name"><p>{{item.type}}</p></div></header><div class="dcf-scroll"><h3>Effect & rolls</h3><div class="field-grid"><label>Rank<input type="number" data-field="system.rank" value="{{system.rank}}"></label><label>Maximum rank<input type="number" data-field="system.maxRank" value="{{system.maxRank}}"></label><label>Mana cost<input type="number" data-field="system.mana" value="{{system.mana}}"></label><label>Action cost<input type="number" data-field="system.actionCost" value="{{system.actionCost}}"></label><label>Damage dice / formula<input type="text" data-field="system.damage" value="{{system.damage}}"></label><label>Flat check bonus<input type="number" data-field="system.checkBonus" value="{{system.checkBonus}}"></label><label>Flat damage bonus<input type="number" data-field="system.damageBonus" value="{{system.damageBonus}}"></label><label>Damage type<input type="text" data-field="system.damageType" value="{{system.damageType}}"></label><label>Range<input type="text" data-field="system.range" value="{{system.range}}"></label><label>Healing slots<input type="number" data-field="system.healSlots" value="{{system.healSlots}}"></label><label>Healing dice (optional)<input type="text" data-field="system.healFormula" value="{{system.healFormula}}"></label><label>Mana restored<input type="number" data-field="system.restoreMana" value="{{system.restoreMana}}"></label><label>Shield slots granted<input type="number" data-field="system.shieldSlots" value="{{system.shieldSlots}}"></label><label>Cooldown description<input type="text" data-field="system.cooldown" value="{{system.cooldown}}"></label><label>Timed cooldown seconds<input type="number" data-field="system.cooldownSeconds" value="{{system.cooldownSeconds}}"></label></div><div class="field-grid"><label>Category<select data-field="system.category">{{{categoryOptions}}}</select></label><label>Check stat<select data-field="system.stat">{{{statOptions}}}</select></label><label>Damage stat<select data-field="system.damageStat">{{{damageStatOptions}}}</select></label><label>Check type<select data-field="system.checkType">{{{checkOptions}}}</select></label><label>Linked weapon skill (owned items)<select data-field="system.skill">{{{skillOptions}}}</select></label><label>Cooldown tracking<select data-field="system.cooldownType">{{{cooldownOptions}}}</select></label><label>Healing recipient<select data-field="system.healingTarget">{{{healingOptions}}}</select></label><label>Consumable kind<select data-field="system.consumableType">{{{consumableOptions}}}</select></label><label>Linked scroll / spellbook spell<select data-field="system.linkedSpell">{{{spellOptions}}}</select></label><label>Location<select data-field="system.location">{{{locationOptions}}}</select></label><label>Body slot<select data-field="system.slot">{{{slotOptions}}}</select></label><label>Quest status<select data-field="system.questStatus">{{{statusOptions}}}</select></label></div><div class="tools"><label><input type="checkbox" data-field="system.passive" {{#if system.passive}}checked{{/if}}> Passive (spells use no check)</label><label><input type="checkbox" data-field="system.requiresCheck" {{#if system.requiresCheck}}checked{{/if}}> Requires a check</label><label><input type="checkbox" data-field="system.equipped" {{#if system.equipped}}checked{{/if}}> Equipped</label><label><input type="checkbox" data-field="system.hotlist" {{#if system.hotlist}}checked{{/if}}> Hotlist</label><label><input type="checkbox" data-field="system.active" {{#if system.active}}checked{{/if}}> Active benefit</label><label><input type="checkbox" data-field="system.external" {{#if system.external}}checked{{/if}}> External Buff</label><label><input type="checkbox" data-field="system.broken" {{#if system.broken}}checked{{/if}}> Broken</label><label><input type="checkbox" data-field="system.consume" {{#if system.consume}}checked{{/if}}> Consume quantity when used</label><label><input type="checkbox" data-field="system.living" {{#if system.living}}checked{{/if}}> Living creature</label><label><input type="checkbox" data-field="system.sealed" {{#if system.sealed}}checked{{/if}}> Liquids contained / sealed</label><label><input type="checkbox" data-field="system.volatile" {{#if system.volatile}}checked{{/if}}> Active volatile item</label></div><label>Base effect / description<textarea data-field="system.description">{{system.description}}</textarea></label><label>Additional rank notes (e.g. 5: Can target two foes)<textarea data-field="system.buffs">{{system.buffs}}</textarea></label><h3>Automated rank upgrades</h3><p class="hint">All unlocked rows apply cumulatively. Include each numeric effect here once; prose notes are displayed without changing rolls.</p>{{#each upgrades}}<section class="project"><div class="field-grid"><label>At Rank<input type="number" data-upgrade-field="rank" data-index="{{index}}" value="{{rank}}"></label><label>Check bonus<input type="number" data-upgrade-field="check" data-index="{{index}}" value="{{check}}"></label><label>Extra base damage dice<input data-upgrade-field="damage" data-index="{{index}}" value="{{damage}}"></label><label>Mana cost adjustment<input type="number" data-upgrade-field="mana" data-index="{{index}}" value="{{mana}}"></label><label>Extra healing slots<input type="number" data-upgrade-field="heal" data-index="{{index}}" value="{{heal}}"></label><label>Healing dice replacement<input data-upgrade-field="healFormula" data-index="{{index}}" value="{{healFormula}}"></label><label>Shield slot replacement<input type="number" data-upgrade-field="shield" data-index="{{index}}" value="{{shield}}"></label><label>Effect text<input data-upgrade-field="text" data-index="{{index}}" value="{{text}}"></label></div><button type="button" data-remove-upgrade="{{index}}">Remove upgrade</button></section>{{/each}}<button type="button" data-add-upgrade>Add rank upgrade</button><h3>Equipment / Race / Class / Buff bonuses</h3><p class="hint">Equipment contributes while equipped; Race, Class and Ability records contribute while Active benefit is selected. External Buffs require an active slot (maximum three).</p><div class="field-grid">{{#each stats}}<label>{{label}} flat<input type="number" data-field="system.statBonuses.{{key}}.flat" value="{{flat}}"></label><label>{{label}} percent<input type="number" data-field="system.statBonuses.{{key}}.percent" value="{{percent}}"></label>{{/each}}</div><div class="field-grid"><label>DR bonus<input type="number" data-field="system.drBonus" value="{{system.drBonus}}"></label><label>Evade bonus<input type="number" data-field="system.evadeBonus" value="{{system.evadeBonus}}"></label><label>Move bonus (ft)<input type="number" data-field="system.moveBonus" value="{{system.moveBonus}}"></label><label>Mana maximum bonus<input type="number" data-field="system.manaBonus" value="{{system.manaBonus}}"></label><label>Skill name receiving Rank bonus<input type="text" data-field="system.skillBonusName" value="{{system.skillBonusName}}"></label><label>Skill Rank bonus<input type="number" data-field="system.skillBonus" value="{{system.skillBonus}}"></label><label>Resistances<input type="text" data-field="system.resistances" value="{{system.resistances}}"></label><label>Immunities<input type="text" data-field="system.immunities" value="{{system.immunities}}"></label><label>Vulnerabilities<input type="text" data-field="system.vulnerabilities" value="{{system.vulnerabilities}}"></label></div><h3>Inventory & record</h3><div class="field-grid"><label>Quantity<input type="number" data-field="system.quantity" value="{{system.quantity}}"></label><label>Weight per item (lb)<input type="number" data-field="system.weight" value="{{system.weight}}"></label><label>Source<input type="text" data-field="system.source" value="{{system.source}}"></label><label>Scroll / spellbook Rank<input type="number" data-field="system.spellRank" value="{{system.spellRank}}"></label><label>Enchantments on item<input type="number" data-field="system.enchants" value="{{system.enchants}}"></label><label>Crafting table tier<input type="number" data-field="system.tier" value="{{system.tier}}"></label><label>Crafting table type<input type="text" data-field="system.tableType" value="{{system.tableType}}"></label><label>Quest reward levels<input type="number" data-field="system.questRewardLevels" value="{{system.questRewardLevels}}"></label><label>Quest reward gold<input type="number" data-field="system.questRewardGold" value="{{system.questRewardGold}}"></label><label>Quest floor<input type="number" data-field="system.questFloor" value="{{system.questFloor}}"></label></div><label>Quest objectives<textarea data-field="objectives">{{objectives}}</textarea></label><label>Prerequisites / blueprint ingredients<textarea data-field="prerequisites">{{prerequisites}}</textarea></label><h3>Outcome effects</h3>{{#each outcomes}}<label>{{label}}<textarea data-field="system.{{key}}">{{value}}</textarea></label>{{/each}}</div></div>