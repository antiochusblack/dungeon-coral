<div class="dcf-shell"><header class="dcf-banner"><img src="{{actor.img}}" alt="Portrait"><div><small>WORLD DUNGEON // CRAWLER FORGE 0.2</small><input data-field="name" value="{{actor.name}}" aria-label="Name"><p>{{actor.type}} · LEVEL {{system.level}} · FLOOR {{system.floor}}</p></div></header><div class="dcf-resources"><section><h3>Health Bar · {{healthPercent}}%</h3><div class="health-slots">{{#each slots}}<button type="button" class="{{#if filled}}filled{{/if}}" data-dcf="health" data-value="{{n}}">{{n}}</button>{{/each}}<button type="button" data-dcf="health" data-value="0">0</button></div><small>{{system.health.value}} / {{system.health.max}} slots · each {{system.health.slot}} damage · DR {{system.totalDR}}</small></section><section><h3>Mana {{system.mana.value}} / {{system.mana.max}}</h3><div class="tools"><button type="button" data-dcf="mana" data-delta="-1">−</button><input type="number" data-field="system.mana.value" value="{{system.mana.value}}" aria-label="Current Mana"><button type="button" data-dcf="mana" data-delta="1">+</button></div>{{#if inEncounter}}<p>Actions {{system.actions}} · extra non-Attack {{system.bonusActions}}</p>{{/if}}</section></div><nav>{{#each sections}}<button type="button" data-section="{{id}}" class="{{#if active}}active{{/if}}">{{label}}</button>{{/each}}</nav><div class="dcf-scroll">{{#if identity}}<h2>Identity</h2><div class="field-grid"><label>Level<input type="number" data-field="system.level" value="{{system.level}}"></label><label>Floor<input type="number" data-field="system.floor" value="{{system.floor}}"></label><label>AI Favor<input type="number" data-field="system.favor" value="{{system.favor}}"></label><label>Race<input type="text" data-field="system.race" value="{{system.race}}"></label><label>Class<input type="text" data-field="system.className" value="{{system.className}}"></label><label>Deity<input type="text" data-field="system.deity" value="{{system.deity}}"></label><label>Pet starting size (numeric)<input type="number" data-field="system.sizeValue" value="{{system.sizeValue}}"></label><label>Size<input type="text" data-field="system.size" value="{{system.size}}"></label><label>Base Move (ft)<input type="number" data-field="system.move" value="{{system.move}}"></label><label>Step (ft)<input type="number" data-field="system.step" value="{{system.step}}"></label><label>Base DR<input type="number" data-field="system.dr" value="{{system.dr}}"></label><label>Evade bonus<input type="number" data-field="system.evadeBonus" value="{{system.evadeBonus}}"></label><label>Health slot strength override (0 = derived)<input type="number" data-field="system.healthSlotOverride" value="{{system.healthSlotOverride}}"></label><label>Health slot count override (0 = derived)<input type="number" data-field="system.healthSlotsOverride" value="{{system.healthSlotsOverride}}"></label><label>Mana override (0 = derived)<input type="number" data-field="system.manaOverride" value="{{system.manaOverride}}"></label><label>Mana bonus<input type="number" data-field="system.mana.bonus" value="{{system.mana.bonus}}"></label></div><h3>Stats</h3><div class="stat-grid">{{#each stats}}<section><button type="button" data-dcf="stat" data-stat="{{key}}">{{label}}</button><label>Base<input type="number" min="1" data-field="system.stats.{{key}}.base" value="{{base}}"></label><label>Enhanced before gear<input type="number" min="1" data-field="system.stats.{{key}}.enhanced" value="{{enhanced}}"></label><p>Total {{total}} · +{{mod}}</p></section>{{/each}}</div><label>Portrait image path<input type="text" data-field="img" value="{{actor.img}}"></label><label>Background<textarea data-field="system.background">{{system.background}}</textarea></label>{{/if}}
{{#if skills}}<h2>Skills & abilities</h2>{{/if}}
{{#if magic}}<h2>Spells</h2><p>Passive spells spend Mana and an action without a check. Choose a target before using Heal Others.</p>{{/if}}
{{#if combat}}<h2>Combat</h2><div class="tools"><button type="button" data-dcf="evade" >Evade</button><button type="button" data-dcf="damage" >Apply damage</button><button type="button" data-dcf="heal" >Heal slots</button><button type="button" data-dcf="rest" >Rest</button><button type="button" data-dcf="move" >Move</button><button type="button" data-dcf="spend" >Spend Attack action</button><button type="button" data-dcf="favorAction" >AI Favor extra action</button><button type="button" data-dcf="assist" >Help / Intervene / Call a Play</button><button type="button" data-dcf="condition" >Apply Debuff</button></div><p>Round {{encounter.round}} · {{phaseName}} · Actions {{system.actions}} · Check penalty −{{system.checkPenalty}} · Move {{system.totalMove}} ft</p><div class="tools">{{#each conditionsList}}<button type="button" data-dcf="removeCondition" data-id="{{id}}">{{label}} ×{{stacks}} · Remove</button>{{/each}}</div><div class="field-grid"><label>Other condition notes<input type="text" data-field="system.conditions" value="{{system.conditions}}"></label><label>Death timer<input type="number" data-field="system.deathTimer" value="{{system.deathTimer}}"></label><label>Resistances (comma-separated)<input type="text" data-field="system.resistances" value="{{system.resistances}}"></label><label>Vulnerabilities (comma-separated)<input type="text" data-field="system.vulnerabilities" value="{{system.vulnerabilities}}"></label><label>Immunities (comma-separated)<input type="text" data-field="system.immunities" value="{{system.immunities}}"></label><label>Shield slots<input type="number" data-field="system.shield.value" value="{{system.shield.value}}"></label><label>Shield slot strength<input type="number" data-field="system.shield.slot" value="{{system.shield.slot}}"></label><label>Action override (0 = standard)<input type="number" data-field="system.actionsOverride" value="{{system.actionsOverride}}"></label></div>{{#if adversary}}<div class="field-grid"><label>Quality (Mob / Elite / Boss)<input type="text" data-field="system.quality" value="{{system.quality}}"></label><label>Boss tier (neighborhood / borough / city / province / country / floor)<input type="text" data-field="system.bossTier" value="{{system.bossTier}}"></label><label>Attack difficulty (include Floor)<input type="number" data-field="system.attack" value="{{system.attack}}"></label><label>Damage formula (all bonuses)<input type="text" data-field="system.damage" value="{{system.damage}}"></label></div><button type="button" data-dcf="mobAttack" >Announce attack & roll damage</button><p>Mob slots = Level, maximum 10. Boss slots derive from tier + Floor. Use overrides for special stat blocks.</p>{{/if}}{{#if isGM}}<h3>Encounter controls</h3><div class="tools"><button type="button" data-dcf="startEncounter" >Start encounter</button><button type="button" data-dcf="cleanup" >Run Clean Up</button><button type="button" data-dcf="nextRound" >Next round</button><button type="button" data-dcf="endEncounter" >End encounter</button><button type="button" data-dcf="actionReset" >Reset this actor’s actions</button></div><div class="tools">{{#each phases}}<button type="button" data-dcf="phase" data-phase="{{id}}" class="{{#if active}}active{{/if}}">{{label}}</button>{{/each}}</div>{{/if}}<p class="hint">Crawlers may interleave actions. Use these phase controls for cleanup and round progression; the normal tracker’s Next Round button is not the automation control.</p>{{/if}}
{{#if gear}}<h2>Gear</h2><div class="field-grid"><label>Gold<input type="number" data-field="system.gold" value="{{system.gold}}"></label><label>Misc. Junk<input type="number" data-field="system.miscJunk" value="{{system.miscJunk}}"></label></div><p>Unaided lift limit {{system.lift}} lb · Hotlist {{hotlist.length}} / 10</p><h3>Hotlist</h3><div class="tools">{{#each hotlist}}<button type="button" data-dcf="{{#if usable}}use{{else}}roll{{/if}}" data-item-id="{{id}}">{{name}}</button>{{/each}}</div><div class="tools"><button type="button" data-dcf="loot" >Loot mob corpses</button><button type="button" data-dcf="common" >Recover common item</button></div>{{/if}}
{{#if advancement}}<h2>Advancement</h2><p>Unspent Stat points {{system.unspentStats}} · Grinding toward next level {{system.grindHours}} hours · Unassigned skill hours {{grindExcess}}</p><div class="tools"><button type="button" data-dcf="checkpoint" >Two-hour / floor checkpoint</button><button type="button" data-dcf="award" >Award levels</button><button type="button" data-dcf="claimStats" >Claim Floor 3+ Stat points</button><button type="button" data-dcf="allocate" >Allocate Stat points</button><button type="button" data-dcf="grind" >Grind</button><button type="button" data-dcf="distributeGrind" >Assign excess hours</button><button type="button" data-dcf="learn" >Learn tutorial untrained skill</button></div><p class="hint">Normal ranks are capped at 15 on Floors 1–5. Rank 16+ benefits activate on Floor 6. Marks accumulate from active Skill Checks. Advancements require confirmation.</p><label>Advancement audit<textarea data-field="system.log">{{system.log}}</textarea></label>{{/if}}
{{#if crafting}}<h2>Crafting</h2><div class="tools"><button type="button" data-dcf="common" >Recover common item (1 Junk)</button><button type="button" data-dcf="craft" >Start crafting project</button></div><p>Misc. Junk {{system.miscJunk}}. Workbench tier contributes to magical crafting checks. Shared time advances once through Dungeon controls.</p>{{#each system.crafts}}<section class="project"><h3>{{name}}</h3><p>Work {{progress}} / {{hours}} hours · Junk reserved {{junk}}</p><button type="button" data-dcf="workCraft" data-id="{{id}}">Work</button><button type="button" data-dcf="resolveCraft" data-id="{{id}}">Resolve</button></section>{{else}}<p class="muted">No active projects.</p>{{/each}}{{/if}}
{{#if dungeon}}<h2>Dungeon HUD</h2><div class="hud-clock"><strong>{{clockHours}}h {{clockMinutes}}m</strong><span>until collapse · Day {{dungeonDay}} · Floor {{dungeonState.floor}}</span></div><p>Neighborhood: {{dungeonState.neighborhood}} · {{#if dungeonState.saferoom}}Saferoom{{else}}In the dungeon{{/if}}</p>{{#if isGM}}<div class="tools"><button type="button" data-dcf="clock" >Dungeon clock / location</button><button type="button" data-dcf="newFloor" >Descend to next floor</button><button type="button" data-dcf="newScene" >Start new scene</button><button type="button" data-dcf="builder" >Encounter power</button><button type="button" data-dcf="partyCheck" >Party check summary</button></div>{{/if}}{{/if}}
{{#if story}}<h2>Story & achievements</h2><div class="field-grid"><label>Popularity<input type="number" data-field="system.popularity" value="{{system.popularity}}"></label><label>Leaderboard position<input type="number" data-field="system.leaderboard" value="{{system.leaderboard}}"></label></div><div class="tools"><button type="button" data-dcf="popularity" >Adjust Popularity / interview result</button></div><label>Sponsors<textarea data-field="system.sponsors">{{system.sponsors}}</textarea></label><label>Patrons<textarea data-field="system.patrons">{{system.patrons}}</textarea></label><label>Past traumas<textarea data-field="system.traumas">{{system.traumas}}</textarea></label><label>Loose ends<textarea data-field="system.looseEnds">{{system.looseEnds}}</textarea></label><label>Regrets<textarea data-field="system.regrets">{{system.regrets}}</textarea></label><label>Notes<textarea data-field="system.notes">{{system.notes}}</textarea></label>{{/if}}
{{#if companions}}<h2>Companions</h2><div class="tools"><button type="button" data-dcf="companion" >Create pet / mount / minion</button></div>{{#if companion}}<div class="field-grid"><label>Owner actor UUID<input type="text" data-field="system.ownerUuid" value="{{system.ownerUuid}}"></label><label>Role<input type="text" data-field="system.companionRole" value="{{system.companionRole}}"></label><label>Loyalty / control<input type="text" data-field="system.loyalty" value="{{system.loyalty}}"></label></div><label>Commands / behaviour<textarea data-field="petCommands">{{petCommands}}</textarea></label>{{/if}}{{#each companionsList}}<section class="project"><h3>{{name}} · {{role}}</h3><button type="button" data-dcf="openCompanion" data-id="{{id}}">Open sheet</button><button type="button" data-dcf="command" data-id="{{id}}">Spend action to command</button></section>{{/each}}<p class="hint">Use the companion’s listed action economy and Health Bar overrides. Command rules vary by creature and ability.</p>{{/if}}
{{#if reference}}<h2>Reference</h2><div class="tools"><button type="button" data-dcf="starter" >Create starter crawler (GM)</button></div><p class="hint">As GM, open the Journals sidebar and click Import DCC game content to import the private JSON pack. Browse imported rules and tables here.</p><label>Search reference titles<input data-search value="{{search}}"></label><h3>Rollable tables</h3>{{#each tablesList}}<button type="button" class="reference-row" data-dcf="rollTable" data-id="{{id}}">{{source}} · {{name}}</button>{{else}}<p>No matching imported tables.</p>{{/each}}<h3>Rules and table references</h3>{{#each references}}<button type="button" class="reference-row" data-dcf="openReference" data-id="{{id}}">{{name}}</button>{{else}}<p>No matching imported references.</p>{{/each}}<p class="hint">Up to 80 matching reference titles are displayed. Use Search to narrow them.</p>{{/if}}
{{#each groups}}<section class="item-group"><header><h3>{{label}}</h3>{{#if @root.editable}}<button type="button" data-dcf="create" data-type="{{type}}">+ {{label}}</button>{{/if}}</header>{{#each items}}<details data-item-id="{{id}}" {{#if open}}open{{/if}}><summary><img src="{{img}}" alt=""><strong>{{name}}</strong>{{#if ranked}}<span>Rank {{effectiveRank}}</span>{{/if}}{{#if cooldown}}<span>{{cooldown}}</span>{{/if}}{{#if rollable}}<button type="button" data-dcf="roll" data-item-id="{{id}}">{{#if system.passive}}Use{{else}}Roll{{/if}}</button>{{/if}}{{#if usable}}<button type="button" data-dcf="use" data-item-id="{{id}}">Use</button>{{/if}}</summary><div class="item-body"><p class="preserve">{{system.description}}</p><p>{{system.location}} · {{system.slot}} · Qty {{system.quantity}} · {{#if system.equipped}}Equipped{{/if}} {{#if system.broken}}BROKEN{{/if}}</p><div class="tools">{{#if ranked}}<button type="button" data-dcf="rank" data-item-id="{{id}}" data-delta="-1">−</button><input class="rank" type="number" min="0" max="{{cap}}" data-rank="{{id}}" value="{{system.rank}}"><button type="button" data-dcf="rank" data-item-id="{{id}}" data-delta="1">+</button><button type="button" data-dcf="mark" data-item-id="{{id}}">{{#if system.advancement}}✓ Marked{{else}}Mark used{{/if}}</button><button type="button" data-dcf="advance" data-item-id="{{id}}">Advance</button>{{/if}}<button type="button" data-dcf="edit" data-item-id="{{id}}">Edit</button>{{#if physical}}<button type="button" data-dcf="equip" data-item-id="{{id}}">Equip / Remove</button>{{/if}}{{#if benefit}}<button type="button" data-dcf="activate" data-item-id="{{id}}">{{#if system.active}}Deactivate benefit{{else}}Activate benefit{{/if}}</button>{{/if}}{{#if canHotlist}}<button type="button" data-dcf="hotlist" data-item-id="{{id}}">{{#if system.hotlist}}Remove Hotlist{{else}}Hotlist{{/if}}</button>{{/if}}{{#if physical}}<button type="button" data-dcf="store" data-item-id="{{id}}">Store / Retrieve</button>{{/if}}<button type="button" data-dcf="export" data-item-id="{{id}}">Copy to Items</button>{{#if physical}}<button type="button" data-dcf="enchant" data-item-id="{{id}}">Add enchantment / risk</button>{{/if}}{{#if quest}}<button type="button" data-dcf="completeQuest" data-item-id="{{id}}">Complete quest</button>{{/if}}<button type="button" class="danger" data-dcf="delete" data-item-id="{{id}}">Delete</button></div></div></details>{{else}}<p class="muted">Drop an item here or create one.</p>{{/each}}</section>{{/each}}</div></div>